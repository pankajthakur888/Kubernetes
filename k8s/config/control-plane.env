# ==============================================================================
# Kubernetes Control-Plane Configuration (control-plane.env)
# ==============================================================================

# API Server Advertise Address
APISERVER_ADVERTISE_ADDRESS="${APISERVER_ADVERTISE_ADDRESS:-${NODE_IP:-}}"

# Upload control-plane certificates to kubeadm-certs secret for 2 hours
UPLOAD_CERTS="${UPLOAD_CERTS:-true}"

# Additional Subject Alternative Names (SANs) for the API Server certificate
EXTRA_SANS="${EXTRA_SANS:-}"

# Control-plane Node Taints (kubeadm default is NoSchedule on control-plane)
CONTROL_PLANE_TAINTS="${CONTROL_PLANE_TAINTS:-}"

# Control-plane Node Labels
CONTROL_PLANE_LABELS="${CONTROL_PLANE_LABELS:-node-role.kubernetes.io/control-plane=true}"

# Extra arguments passed to kubeadm init
KUBEADM_EXTRA_INIT_ARGS="${KUBEADM_EXTRA_INIT_ARGS:-}"

# Extra arguments passed to kubeadm join
KUBEADM_EXTRA_JOIN_ARGS="${KUBEADM_EXTRA_JOIN_ARGS:-}"
