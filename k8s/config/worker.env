# ==============================================================================
# Kubernetes Worker Configuration (worker.env)
# ==============================================================================

# Worker Node Labels
WORKER_LABELS="${WORKER_LABELS:-node-role.kubernetes.io/worker=worker}"

# Worker Node Taints
WORKER_TAINTS="${WORKER_TAINTS:-}"

# Extra arguments passed to kubeadm join
KUBEADM_EXTRA_WORKER_ARGS="${KUBEADM_EXTRA_WORKER_ARGS:-}"
