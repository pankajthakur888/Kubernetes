# ==============================================================================
# Kubernetes Cluster Configuration (cluster.env)
# ==============================================================================
# Global cluster settings used across control-plane and worker nodes.
# All settings can be overridden at runtime via shell environment variables.

# Cluster Role & Target Environment
# Roles: control-plane, control-plane-join, worker
ROLE="${ROLE:-}"

# Environments: onprem, aws, gcp, azure
ENVIRONMENT="${ENVIRONMENT:-onprem}"

# Kubernetes Version Channel (pkgs.k8s.io)
# Supported: v1.30, v1.31, v1.32
K8S_VERSION="${K8S_VERSION:-v1.31}"

# Container Runtime
CRI_SOCKET="${CRI_SOCKET:-unix:///run/containerd/containerd.sock}"
CONTAINERD_CONFIG="${CONTAINERD_CONFIG:-/etc/containerd/config.toml}"

# Network CIDRs (standard upstream Kubernetes defaults)
POD_CIDR="${POD_CIDR:-10.244.0.0/16}"
SERVICE_CIDR="${SERVICE_CIDR:-10.96.0.0/12}"

# High Availability Control Plane Endpoint
# For HA: Must point to Load Balancer VIP / DNS (e.g. k8s-api.example.com or 10.10.10.100)
# Port defaults to 6443
CONTROL_PLANE_ENDPOINT="${CONTROL_PLANE_ENDPOINT:-}"
CONTROL_PLANE_PORT="${CONTROL_PLANE_PORT:-6443}"

# Node IP (auto-detected if blank)
NODE_IP="${NODE_IP:-}"
NODE_NAME="${NODE_NAME:-}"

# Cluster Join Credentials (generated by kubeadm init on CP1)
JOIN_TOKEN="${JOIN_TOKEN:-}"
DISCOVERY_TOKEN_CA_CERT_HASH="${DISCOVERY_TOKEN_CA_CERT_HASH:-}"
CERTIFICATE_KEY="${CERTIFICATE_KEY:-}"

# CNI Selection: calico (default for CKA), cilium (eBPF)
CNI="${CNI:-calico}"
