# ==============================================================================
# K3s Cluster Configuration (cluster.env)
# ==============================================================================
# Global cluster settings used by control-plane and worker nodes.
# All settings can be overridden at runtime via shell environment variables.

# Cluster Identification
CLUSTER_NAME="${CLUSTER_NAME:-k3s-lab}"

# K3s Version: 'stable', 'latest', or a specific release like 'v1.31.5+k3s1'
K3S_VERSION="${K3S_VERSION:-stable}"

# Control Plane API Endpoint
# For HA setups: point to your Load Balancer (e.g., https://10.10.10.100:6443 or https://k3s-api.lab.local:6443)
# For single-node / initial CP1 discovery: point to CP1 (e.g., https://10.10.10.10:6443)
K3S_URL="${K3S_URL:-}"

# Cluster Join Token
# Generated by server-init on CP1 and located at /var/lib/rancher/k3s/server/node-token
K3S_TOKEN="${K3S_TOKEN:-}"

# HA Load Balancer / Virtual IP (VIP) endpoint (IP or Hostname)
API_LB_ENDPOINT="${API_LB_ENDPOINT:-}"

# Additional Subject Alternative Names (SANs) for the API Server TLS Certificate
# Space or comma-separated list of IPs / Hostnames
TLS_SANS="${TLS_SANS:-}"

# Network CIDRs
CLUSTER_CIDR="${CLUSTER_CIDR:-10.42.0.0/16}"
SERVICE_CIDR="${SERVICE_CIDR:-10.43.0.0/16}"
CLUSTER_DNS="${CLUSTER_DNS:-10.43.0.10}"

# CNI Plugin Selection:
#   cilium  (default, installs Cilium eBPF, disables flannel)
#   flannel (embedded K3s CNI with VXLAN)
#   calico  (installs Tigera Calico operator, disables flannel)
#   none    (disables flannel and network-policy for custom CNI)
CNI_PLUGIN="${CNI_PLUGIN:-cilium}"

# Component Toggles
DISABLE_TRAEFIK="${DISABLE_TRAEFIK:-false}"
DISABLE_SERVICELB="${DISABLE_SERVICELB:-false}"
DISABLE_LOCAL_STORAGE="${DISABLE_LOCAL_STORAGE:-false}"
DISABLE_METRICS_SERVER="${DISABLE_METRICS_SERVER:-false}"

# Installation Directory
INSTALL_DIR="${INSTALL_DIR:-/usr/local/bin}"
