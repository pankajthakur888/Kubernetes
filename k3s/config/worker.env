# ==============================================================================
# K3s Worker Node Configuration (worker.env)
# ==============================================================================
# Settings specific to worker (agent) nodes.

# Worker Node Labels (key=value separated by spaces or commas)
# Automatically sets worker role label for clear `kubectl get nodes` output
WORKER_NODE_LABELS="${WORKER_NODE_LABELS:-node-role.kubernetes.io/worker=worker}"

# Worker Node Taints
# Example: "workload=gpu:NoSchedule"
WORKER_NODE_TAINTS="${WORKER_NODE_TAINTS:-}"

# Extra Worker Arguments (appended directly to k3s agent)
WORKER_EXTRA_ARGS="${WORKER_EXTRA_ARGS:-}"
