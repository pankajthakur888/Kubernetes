# ==============================================================================
# K3s Control-Plane Node Configuration (server.env)
# ==============================================================================
# Settings specific to control-plane (server) nodes.

# Control-plane Node Labels (key=value separated by spaces or commas)
SERVER_NODE_LABELS="${SERVER_NODE_LABELS:-node-role.kubernetes.io/control-plane=true}"

# Control-plane Node Taints
# If set, workloads won't schedule on control-plane nodes unless they tolerate the taint.
# Example for dedicated control planes: "node-role.kubernetes.io/control-plane:NoSchedule"
SERVER_NODE_TAINTS="${SERVER_NODE_TAINTS:-}"

# ETCD Embedded Database Configuration
ETCD_EXPOSE_METRICS="${ETCD_EXPOSE_METRICS:-false}"
ETCD_SNAPSHOT_SCHEDULE="${ETCD_SNAPSHOT_SCHEDULE:-0 */12 * * *}"
ETCD_SNAPSHOT_RETENTION="${ETCD_SNAPSHOT_RETENTION:-5}"
ETCD_SNAPSHOT_DIR="${ETCD_SNAPSHOT_DIR:-/var/lib/rancher/k3s/server/db/snapshots}"

# Kubeconfig Permissions Mode (default: 644 for easy user access)
KUBECONFIG_MODE="${KUBECONFIG_MODE:-644}"

# Extra Server Arguments (appended directly to k3s server)
SERVER_EXTRA_ARGS="${SERVER_EXTRA_ARGS:-}"
